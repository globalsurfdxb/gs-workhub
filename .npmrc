# pnpm's default "isolated" node_modules layout uses symlinks into a
# content-addressed store. Next.js's own compiled server runtime does a
# handful of dynamic require()s into its own dependency tree (source-map,
# app-render internals, styled-jsx, ...) that Vercel's static output-file
# tracer can't see through those symlinks — each one Vercel drops from the
# deployed serverless function surfaces as a separate "Cannot find module"
# crash at runtime, one file at a time. Hoisting to a flat, non-symlinked
# node_modules (like npm's default) is the standard fix for this class of
# Vercel + pnpm + Next.js tracing gap.
node-linker=hoisted
