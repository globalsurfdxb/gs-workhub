# Copy to apps/web/.env.local and fill in real values.
# Nothing here is a real credential.

# --- Frontend ---
# GS WorkHub runs entirely against in-memory mock data — there is no real
# backend. Keep this true; NEXT_PUBLIC_API_URL/WS_URL are unused while it is.
NEXT_PUBLIC_USE_MOCK_DATA=true
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"
