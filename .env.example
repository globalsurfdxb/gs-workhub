# Copy to apps/api/.env and apps/web/.env.local and fill in real values.
# Nothing here is a real credential.

# --- Database / Cache ---
DATABASE_URL="postgresql://gs_workhub:gs_workhub_dev_password@localhost:5432/gs_workhub?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_REFRESH_EXPIRES_IN="7d"
 
# --- API ---
API_PORT=4000
API_CORS_ORIGIN="http://localhost:3000"

# --- Azure Blob Storage (Module 10 - File Management) ---
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="gs-workhub-files"

# --- Frontend ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"
